# Mellomting hardened systemd unit (PLAN §64).
#
# This complements the in-process Landlock confinement (PLAN §53-63):
# Landlock is post-start containment against a compromised process;
# these directives restrict the service account from systemd's side.
#
# Install as a mellomting system user, place the config at
# /etc/mellomting/config.yaml and the users/pepper files there too.
# The daemon's Landlock policy is generated from that config
# (security.landlock.mode: required in production, PLAN §55).
#
# Test each directive on the target distribution before relying on it.
# If a directive must be removed, document exactly why (PLAN §64).
[Unit]
Description=Mellomting - authenticated LLM inference proxy
Documentation=https://github.com/stigtsp/mellomting
Wants=network-online.target
After=network-online.target

[Service]
User=mellomting
Group=mellomting
Type=simple
ExecStart=@BINARY_PATH@ serve -config /etc/mellomting/config.yaml
# systemctl reload == SIGHUP == graceful in-place users-file reload
# (PLAN §30, T-M10): the daemon reloads the key store without killing the
# process or severing in-flight streams, unlike a restart. Under
# security.landlock.mode: required the users file is pinned to its startup
# inode, so key rotation/revocation CANNOT take effect via SIGHUP: use a
# full restart (systemctl restart) for those changes; the daemon logs an
# ERROR naming the sandbox and the restart requirement if the reload fails
# (FIX-02/N2).
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# Bound accepted connections (T-L15, PLAN §9.1): the in-process
# max_connections gate closes excess sockets, and this limits the fd
# ceiling (each connection costs at least one fd) so the daemon cannot
# be driven into fd exhaustion. 1024 matches the in-process default;
# raise both together if capacity is needed.
LimitNOFILE=1024

# Directories: runtime socket, state (future), and the accounting log.
RuntimeDirectory=mellomting
StateDirectory=mellomting
LogsDirectory=mellomting
# Pin the modes the installer provisions (0750): systemd creates these
# at 0755 by default, which would silently loosen them on a fresh host.
RuntimeDirectoryMode=0750
StateDirectoryMode=0750
LogsDirectoryMode=0750

UMask=0077

# No privilege escalation, no capabilities at all.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/etc/mellomting
ReadWritePaths=/var/log/mellomting /var/lib/mellomting

# Kernel interfaces.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# System calls. @system-service is the standard allow-list for a service
# like this; @sandbox must be named explicitly alongside it because it is
# NOT a member of @system-service — verified against systemd's
# seccomp-util.c, whose @system-service list runs @resources, @setuid
# with no @sandbox between them. @sandbox carries
# landlock_create_ruleset, landlock_add_rule and landlock_restrict_self,
# so filtering without it makes the daemon's own Landlock confinement
# fail — and under security.landlock.mode: required that is a startup
# abort, not a degradation (systemd issue #26913 is the same trap).
# No SystemCallErrorNumber: an unexpected syscall kills the process
# rather than returning EPERM into a code path that may not check.
SystemCallFilter=@system-service @sandbox
# Without this, a filtered syscall can be re-entered through a secondary
# architecture's ABI (x86-64 hosts also expose i386/x32).
SystemCallArchitectures=native

# Process restrictions.
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Other processes' entries in /proc are hidden. ProcSubset=pid is
# deliberately NOT set: it also hides /proc/sys, which the Go runtime
# reads.
ProtectProc=invisible
# The daemon uses no SysV IPC or POSIX message queues.
RemoveIPC=yes

# Network: only the families Mellomting needs, and only to localhost
# (the backends). Landlock adds port-level connect restrictions on top
# of this (PLAN §60).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
