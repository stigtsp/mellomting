# Add your inference server and model below, then run:
#   mellomting config check
# The service cannot start until both entries are filled in.
# Use 'mellomting config show-effective' to inspect defaults.

version: 1

servers:
  # local:
  #   url: http://127.0.0.1:8000

models:
  # my-model:                 # model name advertised by your server
  #   servers: [local]

server:
  listen:
    network: unix
    address: /run/mellomting/mellomting.sock
    mode: "0660"

# Behind a reverse proxy, name the peers whose X-Forwarded-For may be
# believed: the address it yields is what per-source rate limiting and
# the logs use. Entries are CIDRs, or "unix" for the peer of the socket
# above. Left empty, the header is ignored and the socket peer is the
# client.
  # trusted_proxies:
  #   - unix

auth:
  users_file: /etc/mellomting/users.yaml # created by the installer
  pepper_file: /etc/mellomting/auth.pepper # generated by the installer

security:
  backend_network:
    mode: loopback-only
# The daemon confines itself after startup wherever the host can enforce
# it, and warns when it cannot. Set mode: required to refuse to start
# instead. minimum_abi defaults to 6, which needs Linux 6.12; raising it
# on an older kernel means no sandbox at all rather than a lesser one.
# On macOS the sandbox is Seatbelt; only the section for the running
# platform is read.
#  seatbelt:
#    mode: best-effort
  landlock:
    mode: best-effort
