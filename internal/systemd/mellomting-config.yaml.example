# Add your inference server and model below, then run:
#   mellomting config check
# The service cannot start until both entries are filled in.
# Use 'mellomting config show-effective' to inspect defaults.

version: 1

servers:
  # local:
  #   url: http://127.0.0.1:8000

models:
  # my-model:                 # model name advertised by your server
  #   servers: [local]

server:
  listen:
    network: unix
    address: /run/mellomting/mellomting.sock
    mode: "0660"

# Trust X-Forwarded-For only from these proxy peers (CIDRs or "unix").
# Their client addresses are used for rate limits and logs.
# When unset, use the socket peer's address.
  # trusted_proxies:
  #   - unix

# Enable 'mellomting top'. Only the service account and root can read
# this socket, which exposes client addresses, user agents and token usage.
  # admin_socket: /run/mellomting/admin.sock

auth:
  users_file: /etc/mellomting/users.yaml # created by the installer
  pepper_file: /etc/mellomting/auth.pepper # generated by the installer

security:
  backend_network:
    mode: loopback-only
# Apply the sandbox when available; warn otherwise. Use "required" to
# refuse startup without it. Landlock requires ABI 6 by default.
# macOS uses Seatbelt; only the current platform's setting applies.
#  seatbelt:
#    mode: best-effort
  landlock:
    mode: best-effort
