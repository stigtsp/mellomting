# Mellomting configuration scaffold, written by `mellomting
# --install --systemd`. It is deliberately incomplete: with no servers
# and no models it does not pass validation, so the daemon refuses to
# start until you fill them in. After each edit run
#
#   <mellomting binary> config check -config /etc/mellomting/config.yaml
#
# to see what is still missing; `<mellomting binary> config show-effective`
# prints the effective value and default of every field. The placeholder
# is your installed binary, e.g. /usr/local/bin/mellomting.

version: 1

server:
  listen:
    # unix socket under systemd's RuntimeDirectory, or for loopback TCP:
    #   network: tcp
    #   address: 127.0.0.1:8080
    network: unix
    address: /run/mellomting/mellomting.sock
    mode: "0660" # unix socket mode

  # TLS only with a tcp listener:
  # tls:
  #   cert_file: /etc/mellomting/tls/cert.pem
  #   key_file: /etc/mellomting/tls/key.pem

auth:
  users_file: /etc/mellomting/users.yaml # created empty by the installer
  pepper_file: /etc/mellomting/auth.pepper # generated by the installer

security:
  backend_network:
    # loopback-only | any | allowed-cidrs (add a cidrs: list)
    mode: loopback-only
  landlock:
    # required | best-effort | disabled
    mode: required
    minimum_abi: 8

logging:
  format: json
  level: info # debug | info | warn | error

# Token accounting; off by default, defaults apply when enabled.
# accounting:
#   enabled: true
#   path: /var/log/mellomting/usage.jsonl

# Host-wide rate ceiling; per-key limits come from `key create` flags.
# limits:
#   global_requests_per_second: 100
#   global_burst: 200

# Pre-stream retry budget; nothing is retried once a byte reaches
# the client.
# retry:
#   max_attempts: 3

servers:
  # At least one. url needs an explicit port; the server name is
  # operator-chosen and referenced by models.
  # main-a:
  #   url: http://127.0.0.1:8001
  #   api_key_file: /etc/mellomting/keys/main-a

models:
  # At least one. servers lists the replica names in routing order.
  # my-model:
  #   type: generation
  #   strategy: least-inflight
  #   upstream_model: <vLLM model name>
  #   policy:
  #     max_output_tokens: 32768
  #   servers:
  #     - main-a

# Qualifiers are shelved beyond the first release; do not add a
# qualifiers section.
