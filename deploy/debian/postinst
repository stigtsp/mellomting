#!/bin/sh
# Mellomting Debian package: postinst.
#
# Creates the service account and directories as `mellomting install
# --systemd` does (PLAN §64). It writes nothing into /etc/mellomting:
# the next step, `mellomting init --config /etc/mellomting/config.yaml`,
# creates the configuration and auth files there and refuses to
# overwrite existing ones. The service is neither enabled nor started.
set -e

SERVICE_USER=mellomting
CONF_DIR=/etc/mellomting
LOG_DIR=/var/log/mellomting
STATE_DIR=/var/lib/mellomting
UNIT=mellomting.service

case "$1" in
configure)
	# Same account shape as the installer: a system account with no
	# home directory, its own group, and no login shell.
	if ! getent passwd "$SERVICE_USER" >/dev/null; then
		useradd --system --no-create-home --user-group \
			--home-dir /run/mellomting --shell /usr/sbin/nologin "$SERVICE_USER"
	fi
	# The unit runs as group mellomting. An account created elsewhere
	# with another primary group leaves no such group; say so, as the
	# installer does, instead of failing inside install -g below.
	if [ "$(id -gn "$SERVICE_USER")" != "$SERVICE_USER" ]; then
		echo "service group $SERVICE_USER is missing; run groupadd --system $SERVICE_USER and add user $SERVICE_USER to it" >&2
		exit 1
	fi

	# /run/mellomting comes from the unit's RuntimeDirectory=. install -d
	# re-asserts owner and mode on an existing directory, as the
	# installer does. root:mellomting on the configuration directory is
	# what makes init give its files the service group (PLAN §29.1).
	install -d -o root -g "$SERVICE_USER" -m 0750 "$CONF_DIR"
	install -d -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0750 "$LOG_DIR" "$STATE_DIR"

	# The unit is shipped by the package but never enabled here: that is
	# the operator's step after init. Lift the mask postrm applies on
	# removal so a reinstalled package can be enabled again, and record
	# the unit's [Install] links so postrm purge removes the ones
	# `systemctl enable` creates (the dh_installsystemd --no-enable shape).
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		if deb-systemd-helper debian-installed "$UNIT"; then
			deb-systemd-helper unmask "$UNIT" >/dev/null || true
			if deb-systemd-helper --quiet was-enabled "$UNIT"; then
				deb-systemd-helper enable "$UNIT" >/dev/null || true
			fi
		fi
		deb-systemd-helper update-state "$UNIT" >/dev/null || true
	fi

	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		# $2 is the previously configured version: set on an upgrade,
		# empty on a first install. A running service is restarted so
		# the new binary takes effect; a stopped one stays stopped.
		if [ -n "$2" ]; then
			deb-systemd-invoke try-restart "$UNIT" >/dev/null || true
		fi
	fi
	;;
abort-upgrade | abort-remove | abort-deconfigure) ;;
*)
	echo "postinst called with unknown argument '$1'" >&2
	exit 1
	;;
esac

exit 0
